# Production build settings for the game (read by Vite, whose envDir is the repo root).
# No secrets here: this file is committed. The deployed game is served by Caddy on the same
# origin as the API, so API calls stay relative (/api/...) instead of using the dev value
# of VITE_API_BASE_URL from .env (http://localhost:3000).
VITE_API_BASE_URL=
